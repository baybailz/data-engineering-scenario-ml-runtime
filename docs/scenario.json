  "workflow": "pipeline.yml",
  "actions": { "run": "measure_batch", "reset": "reset" },
  "run_label": "Measure the next batch",
  "pipeline_steps": [
    { "key": "measure", "label": "Measure" },
    { "key": "train", "label": "Train" },
    { "key": "publish", "label": "Publish" }
  ],
  "arch_subtitles": {
    "measure": "40 queries, timed",
    "train": "gradient boosting",
    "publish": "tables + ONNX model"
  },
  "landing": {
    "seed": "measurements",
    "columns": ["query_id", "template_id", "rows_in", "n_joins", "selectivity",
                "median_seconds"]
  },
  "export": {
    "tables": ["predictions", "model_versions", "sla"]
  }
